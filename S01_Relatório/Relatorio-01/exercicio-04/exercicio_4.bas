Dim distancia As Double
Dim tempo As Double
Dim pace As Double

Print "Digite a distancia percorrida (km): "
Input distancia

Print "Digite o tempo total da corrida (min): "
Input tempo

pace = tempo / distancia

Print ""
Print "Distancia: "; distancia; " km"
Print "Tempo: "; tempo; " min"
Print "Pace medio: "; pace; " min/km"

Sleep
